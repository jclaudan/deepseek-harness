# .env.example
# Exemple de fichier d'environnement pour DeepSeek Harness
# Copiez ce fichier en `.env` et adaptez les valeurs pour votre environnement local.

# ---- Application web / dsh ----
# Port local utilisé par l'app (doit correspondre à celui dans entrypoint/nginx)
DSH_PORT=3080

# Hôtes/ports de confiance (séparés par des espaces) utilisés par l'application
# Exemple: TRUSTED_HOSTS="192.168.1.10:3080 192.168.1.11:3080"
TRUSTED_HOSTS=""

# Environnement Node
NODE_ENV=production

# Si le CLI accepte un override d'hôte (souvent refusé par le projet), vous pouvez
# définir DSH_HOST; la configuration actuelle utilise nginx pour exposer le service.
DSH_HOST=127.0.0.1

# ---- Base de données (exemples) ----
# Exemple d'URL unique (substituez par vos valeurs)
DATABASE_URL=postgresql://dbuser:dbpass@db-host:5432/dbname
# Ou variables séparées
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deepseek
DB_USER=dbuser
DB_PASS=dbpass

# ---- Cache / queue ----
REDIS_URL=redis://localhost:6379/0

# ---- Secrets & tokens ----
# Remplacez ces valeurs par des secrets sécurisés, NE LES COMMITTEZ PAS
SESSION_SECRET=change_me_to_a_random_string
JWT_SECRET=change_me_securely

# ---- API externes (exemples) ----
OPENAI_API_KEY=

# ---- Surveillance / erreurs ----
SENTRY_DSN=

# ---- SMTP (envoi d'emails) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password

# ---- Frontend / variables publiques ----
# Variables préfixées NEXT_PUBLIC_* seront exposées au client (si applicables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3080/api
ALLOWED_ORIGINS=http://localhost:3080,http://192.168.1.10:3080

# ---- Notes ----
# - Ne committez pas votre fichier .env contenant des secrets.
# - Adaptez TRUSTED_HOSTS à l'IP:PORT depuis lesquelles les clients accèderont à l'interface.
# - Certaines variables peuvent ne pas être utilisées selon la configuration/monorepo du projet;
#   gardez-les comme exemples et ajoutez celles spécifiques aux packages si nécessaire.
